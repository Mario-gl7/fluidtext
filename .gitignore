.gitignore
# Ignore system files
.DS_Store
Thumbs.db

# Ignore environment and secret files
.env
.env.local
.env.production
.env.development

# Ignore node and dependency folders
node_modules/

# Ignore build and temporary files
dist/
build/
.tmp/
.cache/

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore IDE configuration
.vscode/
.idea/

# Ignore OS-specific hidden files
*.swp
*.swo